# @roxi/routify@3.6.4 declares optional peers capped at vite ^7 and
# @sveltejs/vite-plugin-svelte ^6; this project uses vite 8 / plugin 7.
# npm 10 (bundled with Node 22, used in CI) treats that optional-peer
# conflict as a fatal ERESOLVE on a clean `npm ci`; npm 11 does not.
# Remove once routify publishes a release that accepts these versions.
legacy-peer-deps=true
